[Unit]
Description=Spring Petclinic Application
After=network.target

[Service]
Type=simple
User=jenkins
Group=jenkins
EnvironmentFile=/home/jenkins/petclinic.env
ExecStart=/usr/bin/java -jar /home/jenkins/petclinic.jar \
  --server.port=8081 \
  --spring.profiles.active=postgres
Restart=always

[Install]
WantedBy=multi-user.target
