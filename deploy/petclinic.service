[Unit]
Description=Spring Petclinic Application
After=network.target

[Service]
Type=simple
User=petclinic
Group=petclinic
EnvironmentFile=/etc/petclinic/petclinic.env
ExecStart=/usr/bin/java -jar /opt/petclinic/petclinic.jar --server.port=8081 --spring.profiles.active=postgres
Restart=always

[Install]
WantedBy=multi-user.target
